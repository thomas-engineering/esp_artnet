# Target
CONFIG_IDF_TARGET="esp32s3"

# UART console via USB-JTAG bridge (ttyACM0) — no USB-OTG dependency
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# 8 MB flash + custom partition table
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA with rollback support
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n

# Mozilla CA bundle for GitHub TLS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# WiFi provisioning
CONFIG_WIFI_PROV_SCAN_MAX_ENTRIES=10

# 1 kHz tick for ms-precision delays
CONFIG_FREERTOS_HZ=1000

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
